{
  "name": "auth-lava-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "prettier:check": "prettier --check \"src/**/*.{ts,html,css,scss,json}\"",
    "prettier:format": "prettier --write \"src/**/*.{ts,html,css,scss,json}\"",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "lint-staged": {
    "**/*.{ts,js,html}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "dependencies": {
    "@angular/cdk": "22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/google-maps": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@ng-icons/core": "^32.5.0",
    "@ng-icons/font-awesome": "^33.4.0",
    "@ng-icons/lucide": "^32.5.0",
    "@ng-icons/material-file-icons": "^33.4.0",
    "@ngrx/signals": "^21.1.1",
    "@spartan-ng/brain": "^1.0.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "embla-carousel": ">=8.0.0 <9.0.0",
    "embla-carousel-angular": "^22.0.0",
    "ngx-scrollbar": "^19.1.5",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.0.0",
    "@angular/build": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@ngrx/eslint-plugin": "^21.1.1",
    "@playwright/test": "^1.61.1",
    "@spartan-ng/cli": "^1.0.4",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/google.maps": "^3.65.2",
    "@types/node": "^26.1.1",
    "angular-eslint": "22.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.0.8",
    "postcss": "^8.5.3",
    "prettier": "^3.9.4",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.60.1",
    "vitest": "^4.0.8"
  }
}
