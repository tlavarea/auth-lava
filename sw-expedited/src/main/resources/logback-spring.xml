<configuration>
  <include resource="org/springframework/boot/logging/logback/base.xml"/>
  <!-- Forwards log events to the OpenTelemetry instance installed by LoggingConfiguration, which exports them via
       OTLP per management.opentelemetry.logging.export.otlp.endpoint (application.yaml) - Spring Boot's
       spring-boot-starter-opentelemetry configures that exporter but does not bridge Logback into it itself. -->
  <appender name="OpenTelemetry" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
    <captureMdcAttributes>*</captureMdcAttributes>
    <!-- Buffers log events emitted before LoggingConfiguration's ApplicationReadyEvent listener calls
         OpenTelemetryAppender.install() so they can still be exported once it does. Default (1000) is too small
         here - this app's dev-profile debug logging (Liquibase + jOOQ) alone exceeds it before startup completes. -->
    <numLogsCapturedBeforeOtelInstall>5000</numLogsCapturedBeforeOtelInstall>
  </appender>
  <root>
    <appender-ref ref="OpenTelemetry"/>
  </root>
</configuration>
